{
  "name": "order-integration-n8n-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "tsx --env-file=.env apps/ingress-api/src/main.ts",
    "dev:erp": "tsx --env-file=.env apps/mock-erp/src/main.ts",
    "dev:worker": "tsx --env-file=.env apps/ingress-api/src/worker-main.ts",
    "dev:web": "ng serve --host 127.0.0.1 --proxy-config apps/web/proxy.json",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/smoke-live.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
